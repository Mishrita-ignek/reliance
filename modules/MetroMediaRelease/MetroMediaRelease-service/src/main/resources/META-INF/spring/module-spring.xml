<?xml version="1.0"?>

<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" default-destroy-method="destroy" default-init-method="afterPropertiesSet" xsi:schemaLocation=" http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
	<bean class="com.metro.mediarelease.service.impl.MetroMediaReleaseLocalServiceImpl" id="com.metro.mediarelease.service.MetroMediaReleaseLocalService" />
	<bean class="com.metro.mediarelease.service.impl.MetroMediaReleaseServiceImpl" id="com.metro.mediarelease.service.MetroMediaReleaseService" />
	<bean class="com.metro.mediarelease.service.persistence.impl.MetroMediaReleasePersistenceImpl" id="com.metro.mediarelease.service.persistence.MetroMediaReleasePersistence" parent="basePersistence">
		<property name="dataSource" ref="extDataSource" />
	</bean>
	<bean class="com.metro.mediarelease.service.persistence.impl.MetroMediaReleaseFinderImpl" id="com.metro.mediarelease.service.persistence.MetroMediaReleaseFinder" parent="basePersistence">
		<property name="dataSource" ref="extDataSource" />
	</bean>
</beans>