	</bean>
	<bean class="com.relieanceada.rinfra.portal.pressRelease.service.persistence.impl.PressReleaseFinderImpl" id="com.relieanceada.rinfra.portal.pressRelease.service.persistence.PressReleaseFinder" parent="basePersistence">
