<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping auto-import="false" default-lazy="false">
	<import class="com.relieanceada.rinfra.portal.pressRelease.model.PressRelease" />
	<class name="com.relieanceada.rinfra.portal.pressRelease.model.impl.PressReleaseImpl" table="PRESS_RELEASE_PressRelease">
		<id name="pressId" type="long">
			<generator class="assigned" />
		</id>
		<property name="newsYear" type="com.liferay.portal.dao.orm.hibernate.StringType" />
		<property name="newsDate" type="org.hibernate.type.TimestampType" />
		<property name="heading" type="com.liferay.portal.dao.orm.hibernate.StringType" />
		<property column="data_" name="data" type="com.liferay.portal.dao.orm.hibernate.StringType" />
		<property name="description" type="com.liferay.portal.dao.orm.hibernate.StringType" />
		<property column="show_" name="show" type="com.liferay.portal.dao.orm.hibernate.StringType" />
		<property name="createdDate" type="org.hibernate.type.TimestampType" />
		<property name="fileName" type="com.liferay.portal.dao.orm.hibernate.StringType" />
		<property name="fileURL" type="com.liferay.portal.dao.orm.hibernate.StringType" />
	</class>
</hibernate-mapping>