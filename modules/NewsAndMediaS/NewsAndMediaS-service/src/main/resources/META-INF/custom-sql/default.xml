<?xml version="1.0" encoding="UTF-8"?>
<custom-sql>
	<sql id="getPublication"> 
      <![CDATA[ 
          SELECT * FROM mumbai_metro_news_media WHERE SRNO!=0 
		  AND TO_CHAR (HDATE,'MM/DD/YYYY') LIKE ? ORDER BY HDATE ASC]]>
	</sql>
	
	
