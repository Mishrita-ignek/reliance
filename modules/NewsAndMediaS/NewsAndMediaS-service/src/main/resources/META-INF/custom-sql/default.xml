	<sql id="getNews"> 
      <![CDATA[ 
    	  SELECT * FROM mumbai_metro_news_media WHERE SRNO!=0 AND PUBLICATION = ?
		  AND TO_CHAR (HDATE,'MM/DD/YYYY') LIKE ? ORDER BY HDATE ASC]]>
	</sql>
</custom-sql>

