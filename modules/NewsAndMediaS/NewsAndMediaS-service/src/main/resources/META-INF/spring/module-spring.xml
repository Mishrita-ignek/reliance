	<bean class="com.news.media.service.persistence.impl.NewsAndMediaPersistenceImpl" id="com.news.media.service.persistence.NewsAndMediaPersistence" parent="basePersistence">
		<property name="dataSource" ref="extDataSource" />
	</bean>
	<bean class="com.news.media.service.persistence.impl.NewsAndMediaFinderImpl" id="com.news.media.service.persistence.NewsAndMediaFinder" parent="basePersistence">
		<property name="dataSource" ref="extDataSource" />
