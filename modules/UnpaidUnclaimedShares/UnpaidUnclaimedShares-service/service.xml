<?xml version="1.0"?>
<!DOCTYPE service-builder PUBLIC "-//Liferay//DTD Service Builder 7.0.0//EN" "http://www.liferay.com/dtd/liferay-service-builder_7_0_0.dtd">

<service-builder package-path="com.rinfra.unpaidunclaimedshares">
	<author>Mukesh Patidar</author>
	<namespace>unpaidUnclaimedShare</namespace>
    <entity name="unpaidUnclaimedDevidend" local-service="true" cache-enabled="false"  table="UNPAID_DIVIDEND_SHARE" data-source="extDataSource">
        <column name="SRNO" type="long" primary="true"></column>
        <column name="FOLIO_NO" type="String"></column>
        <column name="NAME" type="String"></column>
        <column name="ADD1" type="String"></column>
        <column name="ADD2" type="String"></column>
        <column name="ADD3" type="String"></column>
        <column name="ADD4" type="String"></column>
        <column name="ADD5" type="String"></column>
        <column name="ADD6" type="String"></column>
        <!-- Name of the Joint Holder:  -->
         <column name="JT1" type="String"></column>
         <column name="JT2" type="String"></column>
         <column name="JT3" type="String"></column>
         <!-- SHARES -->
         <column name="SHARES" type="String"></column>
        <finder name="folioNo" return-type="Collection">
            <finder-column name="FOLIO_NO"></finder-column>
        </finder>
        
	</entity>
</service-builder>