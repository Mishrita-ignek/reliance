<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping auto-import="false" default-lazy="false">
	<import class="com.rinfra.annual.model.AnnualReport" />
	<class name="com.rinfra.annual.model.impl.AnnualReportImpl" table="FINANCIAL_REPORT">
		<id name="SRNO" type="long">
			<generator class="assigned" />
		</id>
		<property name="FINANCIAL_YEARS" type="com.liferay.portal.dao.orm.hibernate.StringType" />
		<property name="FINANCIALDATA" type="com.liferay.portal.dao.orm.hibernate.StringType" />
		<property name="FINANCIAL_DATALINK" type="com.liferay.portal.dao.orm.hibernate.StringType" />
	</class>
</hibernate-mapping>