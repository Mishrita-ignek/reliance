<?xml version="1.0"?>
<!DOCTYPE service-builder PUBLIC "-//Liferay//DTD Service Builder 7.0.0//EN" "http://www.liferay.com/dtd/liferay-service-builder_7_0_0.dtd">

<service-builder package-path="com.rinfra.annual">
	<author>MukeshPatidar</author>
	<namespace>AnnualReport_Portlet</namespace>
	<entity name="AnnualReport" local-service="true" remote-service="true" table="FINANCIAL_REPORT" uuid="false" data-source="extDataSource">
		
		<column name="SRNO" type="long" primary="true"></column>
        <column name="FINANCIAL_YEARS"  type="String"></column>
        <column name="FINANCIALDATA"  type="String"></column>
        <column name="FINANCIAL_DATALINK"  type="String"></column>
        <finder name="FINANCIAL_YEARS" return-type="Collection">
            <finder-column name="FINANCIAL_YEARS"></finder-column>
        </finder>
		
    </entity>
</service-builder>